# כתובת החיבור למסד הנתונים של MongoDB.
DATABASE_URI=mongodb://localhost:27017/your-database
# יש להחליף את ערך הדוגמה במפתח פרטי ארוך לחתימת אסימוני JWT.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
# יש להעתיק לכאן את מפתח ה־API שנוצר בלוח הבקרה של Resend.
RESEND_API_KEY=re_example
# יש להשתמש בכתובת בדיקה של Resend או בכתובת מדומיין מאומת.
MAIL_FROM="Home Management <onboarding@resend.dev>"
# יש להגדיר את הכתובת הקבועה שאליה יישלח מייל אחרי עדכון תשלום ידני.
PAYMENT_NOTIFICATION_EMAIL=payments@example.com
# יש להגדיר את כתובת אפליקציית React כדי שקישורי המייל יובילו לסביבה הנכונה.
APP_URL=http://localhost:5173
